{"schema_version":1,"id":"core-kubernetes-cloud","version":"0.2.0","publisher":"close-enough","capabilities":["matcher-v1","transformation-v1","explanation-v1","risk-v1"],"rules":[{"id":"kubectl-get-gett","command":"kubectl","pattern":"^gett$","replacement":"get","cause":"kubectl subcommand typo","risk":"safe","risk_rationale":"read-only Kubernetes API query"},{"id":"kubectl-apply-aply","command":"kubectl","pattern":"^aply$","replacement":"apply","cause":"kubectl subcommand typo","risk":"high","risk_rationale":"may create or modify Kubernetes resources"},{"id":"kubectl-delete-delet","command":"kubectl","pattern":"^delet$","replacement":"delete","cause":"kubectl subcommand typo","risk":"high","risk_rationale":"may delete Kubernetes resources"},{"id":"helm-install-instal","command":"helm","pattern":"^instal$","replacement":"install","cause":"Helm subcommand typo","risk":"high","risk_rationale":"may create or modify Kubernetes resources"},{"id":"terraform-apply-aply","command":"terraform","pattern":"^aply$","replacement":"apply","cause":"Terraform subcommand typo","risk":"high","risk_rationale":"may create, modify, or destroy infrastructure"},{"id":"aws-s3-ls-lss","command":"aws","pattern":"^s3 lss$","replacement":"s3 ls","cause":"AWS CLI subcommand typo","risk":"safe","risk_rationale":"read-only object-storage listing"},{"id":"kubectl-get-all-namespacess","command":"kubectl","pattern":"^get --all-namespacess$","replacement":"get --all-namespaces","cause":"kubectl flag spelling typo","risk":"safe","risk_rationale":"read-only Kubernetes API query"},{"id":"kubectl-apply-dry-run","command":"kubectl","pattern":"^apply --dry-run$","replacement":"apply --dry-run=client","cause":"Deprecated kubectl dry-run flag form","risk":"high","risk_rationale":"may evaluate Kubernetes resource changes"},{"id":"terraform-plan-outt","command":"terraform","pattern":"^plan -outt=tfplan$","replacement":"plan -out=tfplan","cause":"Terraform plan flag spelling typo","risk":"high","risk_rationale":"may access cloud providers and write a plan file"},{"id":"aws-s3-cp-recursiv","command":"aws","pattern":"^s3 cp --recursiv$","replacement":"s3 cp --recursive","cause":"AWS CLI flag spelling typo","risk":"high","risk_rationale":"may transfer multiple local or remote objects"},{"id":"terraform-refresh","command":"terraform","pattern":"^refresh$","replacement":"plan -refresh-only","cause":"Deprecated Terraform refresh command; review state changes before applying them","risk":"high","risk_rationale":"may access cloud providers and expose state changes"}]}
