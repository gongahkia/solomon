{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gongahkia/solomon",
  "title": "Solomon",
  "description": "Currency layer for internal legal knowledge.",
  "version": "0.1.0",
  "websiteUrl": "https://github.com/gongahkia/solomon",
  "repository": {
    "source": "github",
    "url": "https://github.com/gongahkia/solomon"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/gongahkia/solomon/main/docs/assets/solomon-icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{host}/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token for Solomon MCP HTTP transport.",
          "isRequired": true,
          "isSecret": true,
          "placeholder": "Bearer solomon-token"
        }
      ],
      "variables": {
        "host": {
          "description": "Public Solomon MCP host without scheme or path.",
          "isRequired": true,
          "placeholder": "solomon.example.com"
        }
      }
    },
    {
      "type": "sse",
      "url": "https://{host}/sse",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token for Solomon MCP SSE transport.",
          "isRequired": true,
          "isSecret": true,
          "placeholder": "Bearer solomon-token"
        }
      ],
      "variables": {
        "host": {
          "description": "Public Solomon MCP host without scheme or path.",
          "isRequired": true,
          "placeholder": "solomon.example.com"
        }
      }
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "solomon",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "SOLOMON_DATA_DIR",
          "description": "Directory for Solomon data.",
          "isRequired": false,
          "format": "filepath"
        },
        {
          "name": "SOLOMON_JOURNAL_DIR",
          "description": "Directory for Solomon audit journal files.",
          "isRequired": false,
          "format": "filepath"
        },
        {
          "name": "SOLOMON_DATABASE_URL",
          "description": "SQLite or PostgreSQL database URL.",
          "isRequired": false
        },
        {
          "name": "SOLOMON_MCP_BEARER_TOKEN",
          "description": "Bearer token required by HTTP/SSE transports.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.github.gongahkia/solomon": {
      "submissionTarget": "mcp-registry-draft",
      "auth": {
        "remote": "Bearer token header. OAuth 2.0 is required before Anthropic curated-directory submission.",
        "stdio": "Host-local process; no network auth."
      },
      "tools": [
        {
          "name": "solomon.audit_pack",
          "title": "Export audit pack",
          "readOnlyHint": true,
          "destructiveHint": false
        },
        {
          "name": "solomon.check_currency",
          "title": "Check currency",
          "readOnlyHint": true,
          "destructiveHint": false
        },
        {
          "name": "solomon.dependency_suggestions",
          "title": "List dependency suggestions",
          "readOnlyHint": true,
          "destructiveHint": false
        },
        {
          "name": "solomon.get_dependencies",
          "title": "Get dependencies",
          "readOnlyHint": true,
          "destructiveHint": false
        },
        {
          "name": "solomon.health",
          "title": "Check Solomon health",
          "readOnlyHint": true,
          "destructiveHint": false
        },
        {
          "name": "solomon.impact",
          "title": "Check authority impact",
          "readOnlyHint": true,
          "destructiveHint": false
        },
        {
          "name": "solomon.ingest",
          "title": "Ingest knowledge",
          "readOnlyHint": false,
          "destructiveHint": true
        },
        {
          "name": "solomon.preflight_context",
          "title": "Preflight context",
          "readOnlyHint": true,
          "destructiveHint": false
        },
        {
          "name": "solomon.verify_position",
          "title": "Verify position",
          "readOnlyHint": false,
          "destructiveHint": true
        }
      ]
    }
  }
}
