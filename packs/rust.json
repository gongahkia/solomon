{"schema_version":1,"id":"core-rust","version":"0.4.0","publisher":"solomon","capabilities":["matcher-v1","transformation-v1","explanation-v1","risk-v1"],"rules":[{"id":"cargo-build-buid","command":"cargo","pattern":"^buid$","replacement":"build","preserve_tail":true,"cause":"Cargo subcommand typo","risk":"high","risk_rationale":"may compile code and run build scripts"},{"id":"cargo-test-tes","command":"cargo","pattern":"^tes$","replacement":"test","cause":"Cargo subcommand typo","risk":"high","risk_rationale":"may compile and execute test code"},{"id":"cargo-publish-pubish","command":"cargo","pattern":"^pubish$","replacement":"publish","cause":"Cargo subcommand typo","risk":"high","risk_rationale":"may publish a crate to a registry"},{"id":"rustup-update-updat","command":"rustup","pattern":"^updat$","replacement":"update","cause":"rustup subcommand typo","risk":"high","risk_rationale":"may download and replace toolchains"},{"id":"cargo-version-verison","command":"cargo","pattern":"^--verison$","replacement":"--version","cause":"Cargo flag spelling typo","risk":"safe","risk_rationale":"read-only version query"},{"id":"cargo-build-release","command":"cargo","pattern":"^build --relese$","replacement":"build --release","cause":"Cargo flag spelling typo","risk":"high","risk_rationale":"may compile code and run build scripts"},{"id":"cargo-check-all","command":"cargo","pattern":"^check --all$","replacement":"check --workspace","cause":"Deprecated Cargo workspace flag","risk":"high","risk_rationale":"may compile workspace code and run build scripts"},{"id":"cargo-build-manifest-tmol","command":"cargo","pattern":"^build --manifest-path Cargo\\.tmol$","replacement":"build --manifest-path Cargo.toml","cause":"Cargo manifest path typo","risk":"high","risk_rationale":"may compile code and run build scripts"},{"id":"cargo-test-manifest-tmol","command":"cargo","pattern":"^test --manifest-path Cargo\\.tmol$","replacement":"test --manifest-path Cargo.toml","cause":"Cargo manifest path typo","risk":"high","risk_rationale":"may compile and execute test code"},{"id":"rustc-source-mian","command":"rustc","pattern":"^\\./src/mian\\.rs$","replacement":"./src/main.rs","cause":"Rust source path typo","risk":"high","risk_rationale":"may compile and execute build scripts"},{"id":"cargo-publish","command":"cargo","pattern":"^publish$","replacement":"publish --dry-run","cause":"Cargo publish uploads a crate; dry-run first to validate without uploading","risk":"high","risk_rationale":"may upload a crate to a registry"},{"id":"cargo-clean","command":"cargo","pattern":"^clean$","replacement":"clean --dry-run","cause":"Cargo clean removes generated artifacts; inspect the deletion set first","risk":"high","risk_rationale":"may remove Cargo-generated artifacts"},{"id":"cargo-run","command":"cargo","pattern":"^run$","replacement":"check","cause":"Cargo run executes the package binary; compile-check before running untrusted code","risk":"high","risk_rationale":"may execute a local binary"},{"id":"rustup-update","command":"rustup","pattern":"^update$","replacement":"check","cause":"rustup update downloads and replaces toolchains; check availability first","risk":"high","risk_rationale":"may download and replace toolchains"}]}
