{"schema_version":1,"id":"core-go","version":"0.3.0","publisher":"close-enough","capabilities":["matcher-v1","transformation-v1","explanation-v1","risk-v1"],"rules":[{"id":"go-build-buid","command":"go","pattern":"^buid$","replacement":"build","cause":"Go subcommand typo","risk":"high","risk_rationale":"may compile packages and dependencies"},{"id":"go-test-tes","command":"go","pattern":"^tes$","replacement":"test","cause":"Go subcommand typo","risk":"high","risk_rationale":"may compile and execute test code"},{"id":"go-install-instal","command":"go","pattern":"^instal$","replacement":"install","cause":"Go subcommand typo","risk":"high","risk_rationale":"may compile and install binaries"},{"id":"go-get-gett","command":"go","pattern":"^gett$","replacement":"get","cause":"Go subcommand typo","risk":"high","risk_rationale":"may download modules and modify module files"},{"id":"go-test-count-counnt","command":"go","pattern":"^test -counnt=1$","replacement":"test -count=1","cause":"Go test flag spelling typo","risk":"high","risk_rationale":"may compile and execute test code"},{"id":"go-build-mod-readony","command":"go","pattern":"^build -mod=readony$","replacement":"build -mod=readonly","cause":"Go module flag spelling typo","risk":"high","risk_rationale":"may compile packages and dependencies"},{"id":"gofmt-write-ww","command":"gofmt","pattern":"^-ww$","replacement":"-w","cause":"gofmt flag spelling typo","risk":"high","risk_rationale":"may overwrite Go source files"},{"id":"go-get-download-d","command":"go","pattern":"^get -d$","replacement":"get","cause":"Obsolete Go get download-only flag","risk":"high","risk_rationale":"may download modules and modify module files"},{"id":"go-run-package-mian","command":"go","pattern":"^run \\./cmd/mian$","replacement":"run ./cmd/main","cause":"Go package path typo","risk":"high","risk_rationale":"may compile and execute a Go program"},{"id":"go-test-package-pakcs","command":"go","pattern":"^test \\./internal/pakcs$","replacement":"