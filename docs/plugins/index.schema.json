{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shisa.sh/plugins/index.schema.json",
  "title": "Shisa plugin marketplace index",
  "type": "object",
  "required": ["version", "updated", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
