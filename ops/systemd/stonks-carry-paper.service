[Unit]
Description=Carry paper runner
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=stonks
Group=stonks
WorkingDirectory=/opt/stonks-cli
EnvironmentFile=-/etc/stonks-cli/carry.env
Environment=PATH=/opt/stonks-cli/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/stonks-cli/scripts/carry_pi_paper_runner.sh
Restart=always
RestartSec=30
StandardOutput=append:/var/log/stonks-cli/carry-paper.log
StandardError=append:/var/log/stonks-cli/carry-paper.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stonks-cli /var/log/stonks-cli /etc/stonks-cli

[Install]
WantedBy=multi-user.target
