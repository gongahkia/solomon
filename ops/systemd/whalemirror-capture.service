[Unit]
Description=WhaleMirror 7-day Hyperliquid capture gate
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stonks-cli
Environment=WHALEMIRROR_GATE_ROOT=/var/lib/stonks-cli/whalemirror-gates
Environment="WHALEMIRROR_CAPTURE_COINS=BTC ETH SOL"
Environment=WHALEMIRROR_CAPTURE_DURATION_SECONDS=604800
ExecStart=/opt/stonks-cli/scripts/whalemirror_linux_capture_7d.sh
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
