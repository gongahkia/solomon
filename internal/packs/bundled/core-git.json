{
  "schema_version": 1,
  "id": "core-git",
  "version": "0.5.0",
  "publisher": "close-enough",
  "capabilities": ["matcher-v1", "transformation-v1", "explanation-v1", "risk-v1"],
  "rules": [{
    "id": "git-status-sttaus",
    "command": "git",
    "pattern": "^sttaus$",
    "replacement": "status",
    "cause": "Git subcommand typo",
    "risk": "safe",
    "risk_rationale": "read-only status query"
  }, {
    "id": "git-status-statsu",
    "command": "git",
    "pattern": "^statsu$",
    "replacement": "status",
    "cause": "Git subcommand transposition",
    "risk": "safe",
    "risk_rationale": "read-only status query"
  }, {
    "id": "git-status-stauts",
    "command": "git",
    "pattern": "^stauts$",
    "replacement": "status",
    "cause": "Git subcommand transposition",
    "risk": "safe",
    "risk_rationale": "read-only status query"
  }, {
    "id": "git-log-logg",
    "command": "git",
    "pattern": "^logg$",
    "replacement": "log",
    "cause": "Git subcommand typo",
    "risk": "safe",
    "risk_rationale": "read-only history query"
  }, {
    "id": "git-diff-dif",
    "command": "git",
    "pattern": "^dif$",
    "replacement": "diff",
    "cause": "Git subcommand typo",
    "risk": "safe",
    "risk_rationale": "read-only comparison query"
  }, {
    "id": "git-branch-brnach",
    "command": "git",
    "pattern": "^brnach$",
    "replacement": "branch",
    "cause": "Git subcommand transposition",
    "risk": "safe",
    "risk_rationale": "read-only branch listing without arguments"
  }, {
    "id": "git-checkout-chekcout",
    "command": "git",
    "pattern": "^chekcout$",
    "replacement": "checkout",
    "cause": "Git subcommand transposition",
    "risk": "high",
    "risk_rationale": "may switch the working tree or overwrite files"
  }, {
    "id": "git-commit-comit",
    "command": "git",
    "pattern": "^comit$",
    "replacement": "commit",
    "cause": "Git subcommand typo",
    "risk": "high",
    "risk_rationale": "may create a commit"
  }, {
    "id": "git-push-puhs",
    "command": "git",
    "pattern": "^puhs$",
    "replacement": "push",
    "cause": "Git subcommand transposition",
    "risk": "high",
    "risk_rationale": "may send commits to a remote"
  }, {
    "id": "git-version-verison",
    "command": "git",
    "pattern": "^--verison$",
    "replacement": "--version",
    "cause": "Git flag spelling typo",
    "risk": "safe",
    "risk_rationale": "read-only version query"
  }, {
    "id": "git-status-shortt",
    "command": "git",
    "pattern": "^status --shortt$",
    "replacement": "status --short",
    "cause": "Git flag spelling typo",
    "risk": "safe",
    "risk_rationale": "read-only status query"
  }, {
    "id": "git-log-one-line",
    "command": "git",
    "pattern": "^log --one-line$",
    "replacement": "log --oneline",
    "cause": "Git flag spelling typo",
    "risk": "safe",
    "risk_rationale": "read-only history query"
  }, {
    "id": "git-diff-statss",
    "command": "git",
    "pattern": "^diff --statss$",
    "replacement": "diff --stat",
    "cause": "Git flag spelling typo",
    "risk": "safe",
    "risk_rationale": "read-only comparison query"
  }, {
    "id": "git-rebase-preserve-merges",
    "command": "git",
    "pattern": "^rebase --preserve-merges$",
    "replacement": "rebase --rebase-merges",
    "cause": "Deprecated Git rebase flag",
    "risk": "high",
    "risk_rationale": "may rewrite commit history"
  }, {
    "id": "git-pull-rebase-preserve",
    "command": "git",
    "pattern": "^pull --rebase=preserve$",
    "replacement": "pull --rebase=merges",
    "cause": "Deprecated Git pull rebase mode",
    "risk": "high",
    "risk_rationale": "may contact a remote and rewrite history"
  }, {
    "id": "git-add-gitingore",
    "command": "git",
    "pattern": "^add \\.gitingore$",
    "replacement": "add .gitignore",
    "cause": "Git ignore-file path typo",
    "risk": "high",
    "risk_rationale": "may stage a file for commit"
  }, {
    "id": "git-diff-gitingore",
    "command": "git",
    "pattern": "^diff \\.gitingore$",
    "replacement": "diff .gitignore",
    "cause": "Git ignore-file path typo",
    "risk": "safe",
    "risk_rationale": "read-only file comparison"
  }, {
    "id": "git-add-readme-mkd",
    "command": "git",
    "pattern": "^add README\\.mkd$",
    "replacement": "add README.md",
    "cause": "Project README extension typo",
    "risk": "high",
    "risk_rationale": "may stage a file for commit"
  }, {
    "id": "git-diff-readme-mkd",
    "command": "git",
    "pattern": "^diff README\\.mkd$",
    "replacement": "diff README.md",
    "cause": "Project README extension typo",
    "risk": "safe",
    "risk_rationale": "read-only file comparison"
  }, {
    "id": "git-add-github-workflow",
    "command": "git",
    "pattern": "^add \\.github/workflow$",
    "replacement": "add .github/workflows",
    "cause": "GitHub workflow directory typo",
    "risk": "high",
    "risk_rationale": "may stage files for commit"
  }, {
    "id": "git-diff-github-workflow",
    "command": "git",
    "pattern": "^diff -- \\.github/workflow$",
    "replacement": "diff -- .github/workflows",
    "cause": "GitHub workflow directory typo",
    "risk": "safe",
    "risk_rationale": "read-only file comparison"
  }, {
    "id": "git-push-force",
    "command": "git",
    "pattern": "^push --force$",
    "replacement": "push --force-with-lease",
    "cause": "Force push can overwrite remote commits; a lease checks for unexpected remote updates",
    "risk": "high",
    "risk_rationale": "may overwrite remote commit history"
  }, {
    "id": "git-reset-hard",
    "command": "git",
    "pattern": "^reset --hard$",
    "replacement": "status",
    "cause": "A hard reset discards tracked changes; inspect status before choosing a destructive reset",
    "risk": "high",
    "risk_rationale": "may discard tracked changes"
  }, {
    "id": "git-clean-force",
    "command": "git",
    "pattern": "^clean -f$",
    "replacement": "clean -n",
    "cause": "Forced clean deletes untracked files; dry-run first to inspect the deletion set",
    "risk": "high",
    "risk_rationale": "may delete untracked files"
  }]
}
