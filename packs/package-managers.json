{
  "schema_version": 1,
  "id": "core-package-managers",
  "version": "0.4.0",
  "publisher": "solomon",
  "capabilities": ["matcher-v1", "transformation-v1", "explanation-v1", "risk-v1"],
  "rules": [
    {
      "id": "npm-install-instal",
      "command": "npm",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "npm subcommand typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "npm-uninstall-uninstal",
      "command": "npm",
      "pattern": "^uninstal$",
      "replacement": "uninstall",
      "cause": "npm subcommand typo",
      "risk": "high",
      "risk_rationale": "may remove project dependencies"
    },
    {
      "id": "npm-run-rnu",
      "command": "npm",
      "pattern": "^rnu$",
      "replacement": "run",
      "cause": "npm subcommand transposition",
      "risk": "high",
      "risk_rationale": "may execute arbitrary project scripts"
    },
    {
      "id": "npm-publish-publsih",
      "command": "npm",
      "pattern": "^publsih$",
      "replacement": "publish",
      "cause": "npm subcommand transposition",
      "risk": "high",
      "risk_rationale": "may publish a package to a registry"
    },
    {
      "id": "yarn-install-instal",
      "command": "yarn",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "Yarn subcommand typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "pnpm-install-instal",
      "command": "pnpm",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "pnpm subcommand typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "brew-install-instal",
      "command": "brew",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "Homebrew subcommand typo",
      "risk": "high",
      "risk_rationale": "may download and modify installed packages"
    },
    {
      "id": "npm-install-savee",
      "command": "npm",
      "pattern": "^install --savee$",
      "replacement": "install --save",
      "cause": "npm flag spelling typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and package metadata"
    },
    {
      "id": "npm-install-global-style",
      "command": "npm",
      "pattern": "^install --global-style$",
      "replacement": "install --install-strategy=shallow",
      "cause": "Deprecated npm install layout flag",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "npm-install-legacy-bundling",
      "command": "npm",
      "pattern": "^install --legacy-bundling$",
      "replacement": "install --install-strategy=nested",
      "cause": "Deprecated npm install layout flag",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "pnpm-install-prodd",
      "command": "pnpm",
      "pattern": "^install --prodd$",
      "replacement": "install --prod",
      "cause": "pnpm flag spelling typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "yarn-install-immutible",
      "command": "yarn",
      "pattern": "^install --immutible$",
      "replacement": "install --immutable",
      "cause": "Yarn flag spelling typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "brew-install-forc",
      "command": "brew",
      "pattern": "^install --forc$",
      "replacement": "install --force",
      "cause": "Homebrew flag spelling typo",
      "risk": "high",
      "risk_rationale": "may download and modify installed packages"
    },
    {
      "id": "npm-install-package-path",
      "command": "npm",
      "pattern": "^install \\./pakcage$",
      "replacement": "install ./package",
      "cause": "Local package directory path typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "npm-install-package-manifest",
      "command": "npm",
      "pattern": "^install \\./pakcage\\.json$",
      "replacement": "install ./package.json",
      "cause": "Local package manifest path typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "yarn-install-cwd-package",
      "command": "yarn",
      "pattern": "^install --cwd \\./pakcage$",
      "replacement": "install --cwd ./package",
      "cause": "Project directory path typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "pnpm-install-dir-package",
      "command": "pnpm",
      "pattern": "^install --dir \\./pakcage$",
      "replacement": "install --dir ./package",
      "cause": "Project directory path typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "brew-install-formual",
      "command": "brew",
      "pattern": "^install \\./Formual$",
      "replacement": "install ./Formula",
      "cause": "Local Homebrew formula path typo",
      "risk": "high",
      "risk_rationale": "may download and modify installed packages"
    },
    {
      "id": "npm-publish",
      "command": "npm",
      "pattern": "^publish$",
      "replacement": "pack --dry-run",
      "cause": "Publishing uploads a package to a registry; inspect the package contents before publishing",
      "risk": "high",
      "risk_rationale": "may publish a package to a registry"
    },
    {
      "id": "npm-audit-fix-force",
      "command": "npm",
      "pattern": "^audit fix --force$",
      "replacement": "audit",
      "cause": "Forced audit fixes can apply breaking dependency upgrades; inspect audit findings first",
      "risk": "high",
      "risk_rationale": "may rewrite dependency versions and lockfiles"
    },
    {
      "id": "pnpm-update-latest",
      "command": "pnpm",
      "pattern": "^update --latest$",
      "replacement": "outdated",
      "cause": "Latest dependency updates can cross major versions; inspect available updates first",
      "risk": "high",
      "risk_rationale": "may rewrite dependency versions and lockfiles"
    },
    {
      "id": "brew-upgrade",
      "command": "brew",
      "pattern": "^upgrade$",
      "replacement": "outdated",
      "cause": "Upgrades replace installed packages; inspect outdated packages before upgrading",
      "risk": "high",
      "risk_rationale": "may replace installed packages"
    }
  ]
}
