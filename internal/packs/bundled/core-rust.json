{"schema_version":1,"id":"core-rust","version":"0.3.0","publisher":"close-enough","capabilities":["matcher-v1","transformation-v1","explanation-v1","risk-v1"],"rules":[{"id":"cargo-build-buid","command":"cargo","pattern":"^buid$","replacement":"build","cause":"Cargo subcommand typo","risk":"high","risk_rationale":"may compile code and run build scripts"},{"id":"cargo-test-tes","command":"cargo","pattern":"^tes$","replacement":"test","cause":"Cargo subcommand typo","risk":"high","risk_rationale":"may compile and execute test code"},{"id":"cargo-publish-pubish","command":"cargo","pattern":"^pubish$","replacement":"publish","cause":"Cargo subcommand typo","risk":"high","risk_rationale":"may publish a crate to a registry"},{"id":"rustup-update-updat","command":"rustup","pattern":"^updat$","replacement":"update","cause":"rustup subcommand typo","risk":"high","risk_rationale":"may download and replace toolchains"},{"id":"cargo-version-verison","command":"cargo","pattern":"^--verison$","replacement":"--version","cause":"Cargo flag spelling typo","risk":"safe","risk_rationale":"read-only version query"},{"id":"cargo-build-release","command":"cargo","pattern":"^build --relese$","replacement":"build --release","cause":"Cargo flag spelling typo","risk":"high","risk_rationale":"may compile code and run build scripts"},{"id":"cargo-check-all","command":"cargo","pattern":"^check --all$","replacement":"check --workspace","cause":"Deprecated Cargo workspace flag","risk":"high","risk_rationale":"may compile workspace code and run build scripts"},{"id":"cargo-build-manifest-tmol","command":"cargo","pattern":"^build --manifest-path Cargo\\.tmol$","replacement":"build --manifest-path Cargo.toml","cause":"Cargo manifest path typo","risk":"high","risk_rationale":"may compile code and run build scripts"},{"id":"cargo-test-manifest-tmol","command":"cargo","pattern":"^test --manifest-path Cargo\\.tmol$","replacement":"test --manifest-path Cargo.toml","cause":"Cargo manifest path typo","risk":"high","risk_rationale":"may compile and execute test code"},{"id":"rustc-source-mian","command":"rustc","pattern":"^\\./src/mian\\.rs$","replacement":"./src/main.rs","cause":"Rust source path typo","risk":"high","risk_rationale":"may compile and execute build scripts"}]}
