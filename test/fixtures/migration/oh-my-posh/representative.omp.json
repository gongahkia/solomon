{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "fg": "#d6deeb",
    "muted": "#637777",
    "accent": "#82aaff",
    "success": "#c3e88d",
    "warning": "#ffcb6b",
    "danger": "#ff5370"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "foreground": "p:accent",
          "template": "{{ .Path }}"
        },
        {
          "type": "git",
          "foreground": "p:muted",
          "template": "git:{{ .HEAD }} "
        },
        {
          "type": "python",
          "foreground": "p:success",
          "template": "py {{ .Full }}"
        },
        {
          "type": "status",
          "foreground": "p:danger",
          "template": "exit {{ .Code }}"
        },
        {
          "type": "executiontime",
          "foreground": "p:warning",
          "template": "took {{ .FormattedMs }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "aws",
          "foreground": "p:accent",
          "template": "aws {{ .Profile }}"
        },
        {
          "type": "battery",
          "foreground": "not-a-color",
          "template": "{{ .Percentage }}"
        }
      ]
    }
  ]
}
