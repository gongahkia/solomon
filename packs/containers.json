{"schema_version":1,"id":"core-containers","version":"0.4.0","publisher":"close-enough","capabilities":["matcher-v1","transformation-v1","explanation-v1","risk-v1"],"rules":[{"id":"docker-build-bulid","command":"docker","pattern":"^bulid$","replacement":"build","preserve_tail":true,"cause":"Docker subcommand typo","risk":"high","risk_rationale":"may build images and execute build instructions"},{"id":"docker-run-runn","command":"docker","pattern":"^runn$","replacement":"run","cause":"Docker subcommand typo","risk":"high","risk_rationale":"may create and execute containers"},{"id":"docker-push-puch","command":"docker","pattern":"^puch$","replacement":"push","cause":"Docker subcommand typo","risk":"high","risk_rationale":"may upload an image to a registry"},{"id":"podman-build-bulid","command":"podman","pattern":"^bulid$","replacement":"build","cause":"Podman subcommand typo","risk":"high","risk_rationale":"may build images and execute build instructions"},{"id":"docker-compose-up-upp","command":"docker","pattern":"^compose upp$","replacement":"compose up","cause":"Docker Compose subcommand typo","risk":"high","risk_rationale":"may create and start containers"},{"id":"docker-run-detachd","command":"docker","pattern":"^run --detachd$","replacement":"run --detach","cause":"Docker flag spelling typo","risk":"high","risk_rationale":"may create and execute containers"},{"id":"docker-build-no-cachee","command":"docker","pattern":"^build --no-cachee$","replacement":"build --no-cache","cause":"Docker flag spelling typo","risk":"high","risk_rationale":"may build images and execute build instructions"},{"id":"docker-compose-dryrun","command":"docker","pattern":"^compose --dryrun up$","replacement":"compose --dry-run up","cause":"Docker Compose flag spelling typo","risk":"high","risk_rationale":"may create and start containers"},{"id":"docker-search-stars","command":"docker","pattern":"^search --stars=([0-9]+)$","replacement":"search --filter=stars=$1","cause":"Deprecated Docker search filter","risk":"safe","risk_rationale":"read-only registry search"},{"id":"docker-search-automated","command":"docker","pattern":"^search --automated$","replacement":"search --filter=is-automated=true","cause":"Deprecated Docker search filter","risk":"safe","risk_rationale":"read-only registry search"},{"id":"docker-build-dockerfil","command":"docker","pattern":"^build -f Dockerfil \\.$","replacement":"build -f Dockerfile .","cause":"Dockerfile path typo","risk":"high","risk_rationale":"may build images and execute build instructions"},{"id":"docker-compose-file-yamll","command":"docker","pattern":"^compose -f compose\\.yamll up$","replacement":"compose -f compose.yaml up","cause":"Compose project file path typo","risk":"high","risk_rationale":"may create and start containers"},{"id":"docker-compose-legacy-file-yamll","command":"docker","pattern":"^compose -f docker-compose\\.yamll up$","replacement":"compose -f docker-compose.yaml up","cause":"Compose project file path typo","risk":"high","risk_rationale":"may create and start containers"},{"id":"docker-system-prune","command":"docker","pattern":"^system prune$","replacement":"system df","cause":"Docker system prune deletes unused resources; inspect disk use first","risk":"high","risk_rationale":"may remove containers, networks, images, and build cache"},{"id":"docker-system-prune-all-volumes","command":"docker","pattern":"^system prune -a --volumes$","replacement":"system df","cause":"Docker system prune with volumes can delete unused images and volumes; inspect disk use first","risk":"high","risk_rationale":"may remove containers, networks, images, build cache, and volumes"},{"id":"docker-compose-down-volumes","command":"docker","pattern":"^compose down -v$","replacement":"compose ps -a","cause":"Compose down with volumes deletes persistent data; inspect containers first","risk":"high","risk_rationale":"may remove containers, networks, and volumes"},{"id":"docker-run-privileged","command":"docker","pattern":"^run --privileged$","replacement":"run --cap-drop=ALL","cause":"Privileged containers can control the host; start without elevated capabilities","risk":"high","risk_rationale":"may grant a container broad host access"},{"id":"docker-rm-force","command":"docker","pattern":"^rm --force$","replacement":"ps -a","cause":"Force removal can kill a running container; inspect container state first","risk":"high","risk_rationale":"may force-stop and remove containers"},{"id":"docker-compose-up","command":"docker","pattern":"^compose up$","replacement":"compose config","cause":"Compose up creates and starts containers; render configuration first","risk":"high","risk_rationale":"may create and start containers"}]}
