{
  "schema_version": 1,
  "id": "package-manager-regression",
  "version": "1.0.0",
  "publisher": "close-enough",
  "rules": [
    {
      "id": "npm-install-instal",
      "command": "npm",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "npm subcommand typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    }
  ]
}
