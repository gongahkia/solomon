apiVersion: v1
kind: Config
clusters:
  - name: payments-cluster
    cluster:
      server: https://payments.prod.example
  - name: staging-cluster
    cluster:
      server: https://staging.example
contexts:
  - name: payments-prod-admin
    context:
      cluster: payments-cluster
      namespace: payments
  - name: staging
    context:
      cluster: staging-cluster
      namespace: default
current-context: payments-prod-admin
