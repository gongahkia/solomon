{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["oidc", "legacy-api-key"]},
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {"type": "string"},
            "audience": {"type": "string"},
            "roleClaim": {"type": "string", "minLength": 1},
            "roleMappings": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "legacyApiKeySecret": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        }
      },
      "required": ["mode"]
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "passwordKey": {"type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "sslMode": {"type": "string"}
      },
      "required": ["existingSecret", "passwordKey", "user", "name", "port"]
    },
    "secrets": {
      "type": "object",
      "properties": {
        "contentEncryption": {
          "type": "object",
          "properties": {
            "existingSecret": {"type": "string"},
            "key": {"type": "string", "minLength": 1},
            "keyRef": {"type": "string"}
          },
          "required": ["existingSecret", "key", "keyRef"]
        }
      },
      "required": ["contentEncryption"]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}
      },
      "required": ["accessModes", "size"]
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "service": {"type": "object", "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
        "persistence": {"type": "object"}
      },
      "required": ["enabled"]
    },
    "api": {"type": "object"},
    "console": {"type": "object"},
    "worker": {
      "type": "object",
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "sourceSyncIntervalSeconds": {"type": "integer", "minimum": 5},
        "sourceSyncLimit": {"type": "integer", "minimum": 1}
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "openTelemetry": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "serviceName": {"type": "string", "minLength": 1},
            "endpoint": {"type": "string"}
          }
        }
      }
    }
  }
}
