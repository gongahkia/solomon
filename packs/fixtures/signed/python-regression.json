{
  "schema_version": 1,
  "id": "python-regression",
  "version": "1.0.0",
  "publisher": "solomon",
  "rules": [
    {
      "id": "python-version-verison",
      "command": "python",
      "pattern": "^--verison$",
      "replacement": "--version",
      "cause": "Python flag spelling typo",
      "risk": "safe",
      "risk_rationale": "read-only version query"
    }
  ]
}
