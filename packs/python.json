{"schema_version":1,"id":"core-python","version":"0.4.0","publisher":"close-enough","capabilities":["matcher-v1","transformation-v1","explanation-v1","risk-v1"],"rules":[{"id":"python-pip-install-instal","command":"python","pattern":"^-m pip instal$","replacement":"-m pip install","cause":"pip subcommand typo","risk":"high","risk_rationale":"may modify dependencies and run build scripts"},{"id":"python-venv-venvv","command":"python","pattern":"^-m venvv$","replacement":"-m venv","cause":"Python module subcommand typo","risk":"high","risk_rationale":"may create or modify a virtual environment"},{"id":"pip-install-instal","command":"pip","pattern":"^instal$","replacement":"install","cause":"pip subcommand typo","risk":"high","risk_rationale":"may modify dependencies and run build scripts"},{"id":"uv-run-rnu","command":"uv","pattern":"^rnu$","replacement":"run","cause":"uv subcommand transposition","risk":"high","risk_rationale":"may execute arbitrary project code"},{"id":"python-version-verison","command":"python","pattern":"^--verison$","replacement":"--version","cause":"Python flag spelling typo","risk":"safe","risk_rationale":"read-only version query"},{"id":"pip-install-no-dep","command":"pip","pattern":"^install --no-dep$","replacement":"install --no-deps","cause":"pip flag spelling typo","risk":"high","risk_rationale":"may modify dependency resolution and installed packages"},{"id":"pip-install-2020-resolver","command":"pip","pattern":"^install --use-feature=2020-resolver$","replacement":"install","cause":"Obsolete pip resolver feature flag","risk":"high","risk_rationale":"may modify dependencies and run build scripts"},{"id":"python-entrypoint-maine","command":"python","pattern":"^\\./src/maine\\.py$","replacement":"./src/main.py","cause":"Python entrypoint path typo","risk":"high","risk_rationale":"may execute project code"},{"id":"pytest-tests-test","command":"pytest","pattern":"^\\./test$","replacement":"./tests","cause":"Python test directory path typo","risk":"high","risk_rationale":"may execute project test code"},{"id":"pip-install-requiremnts","command":"pip","pattern":"^install -r requiremnts\\.txt$","replacement":"install -r requirements.txt","cause":"Python requirements file path typo","risk":"high","risk_rationale":"may modify dependencies and run build scripts"},{"id":"uv-run-project-projet","command":"uv","pattern":"^run --project \\./projet$","replacement":"run --project ./project","cause":"Python project directory path typo","risk":"high","risk_rationale":"may execute arbitrary project code"},{"id":"python-inline-code","command":"python","pattern":"^-c$","replacement":"-m py_compile","cause":"Inline Python execution runs supplied source text; syntax-check before running untrusted code","risk":"high","risk_rationale":"may execute arbitrary code"},{"id":"pip-install-break-system-packages","command":"pip","pattern":"^install --break-system-packages$","replacement":"install --user","cause":"Breaking system package protection can overwrite managed Python files; use a user install or virtual environment","risk":"high","risk_rationale":"may modify system-managed packages"}]}
