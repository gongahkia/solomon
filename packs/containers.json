{"schema_version":1,"id":"core-containers","version":"0.3.0","publisher":"close-enough","capabilities":["matcher-v1","transformation-v1","explanation-v1","risk-v1"],"rules":[{"id":"docker-build-bulid","command":"docker","pattern":"^bulid$","replacement":"build","cause":"Docker subcommand typo","risk":"high","risk_rationale":"may build images and execute build instructions"},{"id":"docker-run-runn","command":"docker","pattern":"^runn$","replacement":"run","cause":"Docker subcommand typo","risk":"high","risk_rationale":"may create and execute containers"},{"id":"docker-push-puch","command":"docker","pattern":"^puch$","replacement":"push","cause":"Docker subcommand typo","risk":"high","risk_rationale":"may upload an image to a registry"},{"id":"podman-build-bulid","command":"podman","pattern":"^bulid$","replacement":"build","cause":"Podman subcommand typo","risk":"high","risk_rationale":"may build images and execute build instructions"},{"id":"docker-compose-up-upp","command":"docker","pattern":"^compose upp$","replacement":"compose up","cause":"Docker Compose subcommand typo","risk":"high","risk_rationale":"may create and start containers"},{"id":"docker-run-detachd","command":"docker","pattern":"^run --detachd$","replacement":"run --detach","cause":"Docker flag spelling typo","risk":"high","risk_rationale":"may create and execute containers"},{"id":"docker-build-no-cachee","command":"docker","pattern":"^build --no-cachee$","replacement":"build --no-cache","cause":"Docker flag spelling typo","risk":"high","risk_rationale":"may build images and execute build instructions"},{"id":"docker-compose-dryrun","command":"docker","pattern":"^compose --dryrun up$","replacement":"compose --dry-run up","cause":"Docker Compose flag spelling typo","risk":"high","risk_rationale":"may create and start containers"},{"id":"docker-search-stars","command":"docker","pattern":"^search --stars=([0-9]+)$","replacement":"search --filter=stars=$1","cause":"Deprecated Docker search filter","risk":"safe","risk_rationale":"read-only registry search"},{"id":"docker-search-automated","command":"docker","pattern":"^search --automated$","replacement":"search --filter=is-automated=true","cause":"Deprecated Docker search filter","risk":"safe","risk_rationale":"read-only registry search"},{"id":"docker-build-dockerfil","command":"docker","pattern":"^build -f Dockerfil \\.$","replacement":"build -f Dockerfile .","cause":"Dockerfile path typo","risk":"high","risk_rationale":"may build images and execute build instructions"},{"id":"docker-compose-file-yamll","command":"docker","pattern":"^compose -f compose\\.yamll up$","replacement":"compose -f compose.yaml up","cause":"Compose project file path typo","risk":"high","risk_rationale":"may create and start containers"},{"id":"docker-compose-legacy-file-yamll","command":"docker","pattern":"^compose -f docker-compose\\.yamll up$","replacement":"compose -f docker-compose.yaml up","cause":"Compose project file path typo","risk":"high","risk_rationale":"may create and start containers"}]}
