# Maintainer: Shisa maintainers <angryapplegravy@gmail.com>
# shellcheck shell=bash disable=SC2034,SC2154

pkgname=shisa-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Daemon-backed async-first cross-shell prompt'
arch=('x86_64')
url='https://github.com/gongahkia/shisa'
license=('MIT')
depends=('glibc')
provides=('shisa')
conflicts=('shisa' 'shisa-git')
_release_tag="v${pkgver}"
_release_name="shisa-${_release_tag}-linux-x64"
source_x86_64=(
  "${_release_name}.tar.gz::${url}/releases/download/${_release_tag}/${_release_name}.tar.gz"
  "${_release_name}.tar.gz.sha256::${url}/releases/download/${_release_tag}/${_release_name}.tar.gz.sha256"
)
sha256sums_x86_64=('SKIP' 'SKIP')

prepare() {
  local expected actual
  expected="$(awk '{ print $1; exit }' "$srcdir/${_release_name}.tar.gz.sha256")"
  actual="$(sha256sum "$srcdir/${_release_name}.tar.gz" | awk '{ print $1; exit }')"
  [[ "$expected" == "$actual" ]]
}

package() {
  install -Dm755 "$srcdir/${_release_name}/shisa" "$pkgdir/usr/bin/shisa"
  install -Dm755 "$srcdir/${_release_name}/shisad" "$pkgdir/usr/bin/shisad"
  install -Dm755 "$srcdir/${_release_name}/shisa-supervisor" "$pkgdir/usr/bin/shisa-supervisor"
  install -Dm644 "$srcdir/${_release_name}/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/${_release_name}/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/${_release_name}/init/shisa.zsh" "$pkgdir/usr/share/shisa/init/shisa.zsh"
  install -Dm644 "$srcdir/${_release_name}/init/shisa.bash" "$pkgdir/usr/share/shisa/init/shisa.bash"
  install -Dm644 "$srcdir/${_release_name}/init/shisa.fish" "$pkgdir/usr/share/shisa/init/shisa.fish"
  install -Dm644 "$srcdir/${_release_name}/init/shisa.nu" "$pkgdir/usr/share/shisa/init/shisa.nu"
  install -Dm644 "$srcdir/${_release_name}/init/shisa.ps1" "$pkgdir/usr/share/shisa/init/shisa.ps1"
  install -d "$pkgdir/usr/share/shisa"
  cp -R "$srcdir/${_release_name}/themes" "$pkgdir/usr/share/shisa/themes"
  cp -R "$srcdir/${_release_name}/examples" "$pkgdir/usr/share/shisa/examples"
}
