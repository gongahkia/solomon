{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/plugins/index.schema.json",
  "title": "Shisa plugin marketplace index",
  "type": "object",
  "required": ["version", "updated", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "manifest_sha256", "signatures"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "signatures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["scheme", "public_key", "signature_url", "trusted_comment"],
                  "additionalProperties": false,
                  "properties": {
                    "scheme": {
                      "const": "minisign"
                    },
                    "public_key": {
                      "type": "string",
                      "pattern": "^RW[A-Za-z0-9+/=]+$"
                    },
                    "signature_url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trusted_comment": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["scheme", "bundle_url", "certificate_identity", "certificate_issuer"],
                  "additionalProperties": false,
                  "properties": {
                    "scheme": {
                      "const": "sigstore"
                    },
                    "bundle_url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "certificate_identity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "certificate_issuer": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
