{
  "schema_version": 1,
  "id": "core-package-managers",
  "version": "0.1.0",
  "publisher": "close-enough",
  "capabilities": ["matcher-v1", "transformation-v1", "explanation-v1", "risk-v1"],
  "rules": [
    {
      "id": "npm-install-instal",
      "command": "npm",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "npm subcommand typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "npm-uninstall-uninstal",
      "command": "npm",
      "pattern": "^uninstal$",
      "replacement": "uninstall",
      "cause": "npm subcommand typo",
      "risk": "high",
      "risk_rationale": "may remove project dependencies"
    },
    {
      "id": "npm-run-rnu",
      "command": "npm",
      "pattern": "^rnu$",
      "replacement": "run",
      "cause": "npm subcommand transposition",
      "risk": "high",
      "risk_rationale": "may execute arbitrary project scripts"
    },
    {
      "id": "npm-publish-publsih",
      "command": "npm",
      "pattern": "^publsih$",
      "replacement": "publish",
      "cause": "npm subcommand transposition",
      "risk": "high",
      "risk_rationale": "may publish a package to a registry"
    },
    {
      "id": "yarn-install-instal",
      "command": "yarn",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "Yarn subcommand typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "pnpm-install-instal",
      "command": "pnpm",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "pnpm subcommand typo",
      "risk": "high",
      "risk_rationale": "may modify dependencies and run install scripts"
    },
    {
      "id": "brew-install-instal",
      "command": "brew",
      "pattern": "^instal$",
      "replacement": "install",
      "cause": "Homebrew subcommand typo",
      "risk": "high",
      "risk_rationale": "may download and modify installed packages"
    }
  ]
}
