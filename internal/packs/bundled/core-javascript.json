{
  "schema_version": 1,
  "id": "core-javascript",
  "version": "0.4.0",
  "publisher": "close-enough",
  "capabilities": ["matcher-v1", "transformation-v1", "explanation-v1", "risk-v1"],
  "rules": [{
    "id": "bun-install-instal",
    "command": "bun",
    "pattern": "^instal$",
    "replacement": "install",
    "cause": "Bun subcommand typo",
    "risk": "high",
    "risk_rationale": "may modify dependencies and run install scripts"
  }, {
    "id": "bun-run-rnu",
    "command": "bun",
    "pattern": "^rnu$",
    "replacement": "run",
    "cause": "Bun subcommand transposition",
    "risk": "high",
    "risk_rationale": "may execute arbitrary project scripts"
  }, {
    "id": "deno-run-rn",
    "command": "deno",
    "pattern": "^rn$",
    "replacement": "run",
    "cause": "Deno subcommand transposition",
    "risk": "high",
    "risk_rationale": "may execute local or remote code"
  }, {
    "id": "deno-test-tes",
    "command": "deno",
    "pattern": "^tes$",
    "replacement": "test",
    "cause": "Deno subcommand typo",
    "risk": "high",
    "risk_rationale": "may execute project test code"
  }, {
    "id": "npx-create-creat",
    "command": "npx",
    "pattern": "^creat$",
    "replacement": "create",
    "cause": "npx subcommand typo",
    "risk": "high",
    "risk_rationale": "may download and execute a package"
  }, {
    "id": "node-version-verison",
    "command": "node",
    "pattern": "^--verison$",
    "replacement": "--version",
    "cause": "Node.js flag spelling typo",
    "risk": "safe",
    "risk_rationale": "read-only version query"
  }, {
    "id": "bun-version-verison",
    "command": "bun",
    "pattern": "^--verison$",
    "replacement": "--version",
    "cause": "Bun flag spelling typo",
    "risk": "safe",
    "risk_rationale": "read-only version query"
  }, {
    "id": "deno-version-verison",
    "command": "deno",
    "pattern": "^--verison$",
    "replacement": "--version",
    "cause": "Deno flag spelling typo",
    "risk": "safe",
    "risk_rationale": "read-only version query"
  }, {
    "id": "node-no-experimental-require-module",
    "command": "node",
    "pattern": "^--no-experimental-require-module$",
    "replacement": "--no-require-module",
    "cause": "Legacy Node.js flag name",
    "risk": "unknown",
    "risk_rationale": "changes ECMAScript module loading behavior"
  }, {
    "id": "node-entrypoint-inde",
    "command": "node",
    "pattern": "^\\./src/inde\\.js$",
    "replacement": "./src/index.js",
    "cause": "JavaScript entrypoint path typo",
    "risk": "high",
    "risk_rationale": "may execute project code"
  }, {
    "id": "bun-run-entrypoint-inde",
    "command": "bun",
    "pattern": "^run \\./src/inde\\.ts$",
    "replacement": "run ./src/index.ts",
    "cause": "TypeScript entrypoint path typo",
    "risk": "high",
    "risk_rationale": "may execute project code"
  }, {
    "id": "deno-run-entrypoint-tss",
    "command": "deno",
    "pattern": "^run \\./main\\.tss$",
    "replacement": "run ./main.ts",
    "cause": "TypeScript entrypoint extension typo",
    "risk": "high",
    "risk_rationale": "may execute local or remote code"
  }, {
    "id": "deno-task-config-josn",
    "command": "deno",
    "pattern": "^task --config deno\\.josn$",
    "replacement": "task --config deno.json",
    "cause": "Deno project configuration path typo",
    "risk": "high",
    "risk_rationale": "may execute project task code"
  }, {
    "id": "node-eval",
    "command": "node",
    "pattern": "^--eval$",
    "replacement": "--check",
    "cause": "Node.js eval executes supplied source text; syntax-check before running untrusted code",
    "risk": "high",
    "risk_rationale": "may execute arbitrary code"
  }, {
    "id": "deno-run-allow-all",
    "command": "deno",
    "pattern": "^run --allow-all$",
    "replacement": "run --allow-read",
    "cause": "Deno allow-all grants every permission; start with the smallest required permission set",
    "risk": "high",
    "risk_rationale": "may grant filesystem, network, process, and environment access"
  }, {
    "id": "npx-yes",
    "command": "npx",
    "pattern": "^--yes$",
    "replacement": "--no-install",
    "cause": "npx automatic installs can execute an unexpected package; require an already-installed command first",
    "risk": "high",
    "risk_rationale": "may download and execute a package"
  }]
}
